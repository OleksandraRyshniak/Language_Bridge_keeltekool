@model Keeltekooli.Models.EmailViewModel

@{
    ViewBag.Title = "Saada e-mail";
}

<h2>@ViewBag.Title</h2>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">
        @ViewBag.Message
    </div>
}

@using (Html.BeginForm("SendEmailop", "SendEmail", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        @Html.LabelFor(m => m.Subject, "Teema")
        @Html.TextBoxFor(m => m.Subject, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Subject)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Body, "Sisu")
        @Html.TextAreaFor(m => m.Body, new { @class = "form-control", rows = 6 })
        @Html.ValidationMessageFor(m => m.Body)
    </div>

    <br />

    <div class="form-group mt-4">
        <div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-success">
                <span class="glyphicon glyphicon-plus"></span> Saada
            </button>

            @Html.ActionLink(
                                  " Tagasi nimekirja",
                                  "MinuKool",
                                  "Koolitus",
                                       null,
                                       new { @class = "btn btn-secondary" }
                                   )
        </div>
    </div>
}