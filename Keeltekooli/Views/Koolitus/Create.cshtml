@model Keeltekooli.Models.Koolitus

@{
    ViewBag.Title = "Lisa uus koolitus";
}

<h2>Lisa uus koolitus</h2>


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            @Html.LabelFor(model => model.KeelekursusId, "Kursuse nimetus", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("KeelekursusId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.KeelekursusId, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.OpetajaId, "Õpetaja", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownList("OpetajaId", null, htmlAttributes: new { @class = "form-control" })
                @Html.ValidationMessageFor(model => model.OpetajaId, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.AlgusKuupaev, "Alguskuupäev", htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.TextBoxFor(model => model.AlgusKuupaev,
                         "{0:yyyy-MM-dd}",
                         new { @class = "form-control", type = "date" })

                @Html.ValidationMessageFor(model => model.AlgusKuupaev, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.LoppKuupaev, "Lõppkuupäev", htmlAttributes: new { @class = "control-label col-md-2" })

            <div class="col-md-10">
                @Html.TextBoxFor(model => model.LoppKuupaev,
                         "{0:yyyy-MM-dd}",
                         new { @class = "form-control", type = "date" })

                @Html.ValidationMessageFor(model => model.LoppKuupaev, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group">
            @Html.LabelFor(model => model.Hind, "Hind (€)", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.Hind, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.Hind, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            @Html.LabelFor(model => model.MaxOsalejaid, "Maksimaalne osalejate arv", htmlAttributes: new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.EditorFor(model => model.MaxOsalejaid, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.MaxOsalejaid, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="form-group mt-4">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" class="btn btn-success">
                    <span class="glyphicon glyphicon-plus"></span> Lisa koolitus
                </button>

                @Html.ActionLink(
                       " Tagasi nimekirja",
                       "Index",
                       null,
                       new { @class = "btn btn-secondary" }
                   )
            </div>
        </div>
    </div>}
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
